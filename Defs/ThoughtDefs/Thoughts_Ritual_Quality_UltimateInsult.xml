<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--            CHANNELING              -->
  <ThoughtDef>
    <defName>TerribleInsult</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>terrible insulting</label>
        <description>That insulting was botched and the mood was way off. What an awkward ceremony.</description>
        <baseMoodEffect>+2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>BoringInsult</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>boring insulting</label>
        <description>That insulting lacked passion and the technique wasn't great.</description>
        <baseMoodEffect>+1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>SatisfyingInsult</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>satisfying insulting</label>
        <description>That insulting was satisfying. The awakened has been granted a wonderful gift.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>SpectacularInsult</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>spectacular insulting</label>
        <description>The mind's many wonders were laid clear for the briefest of instants.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>