<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RitualBehaviorDef ParentName="InsultBehaviorBase">
    <defName>UltimateInsult</defName>
    <preceptRequirements>
      <li Class="PreceptRequirement_Altar" />
    </preceptRequirements>
    <durationTicks>6000</durationTicks>
    <roles Inherit="False">
      <li Class="RitualRoleColonist">
        <label>MadMan</label>
        <id>madman</id>
        <required>True</required>
        <maxCount>1</maxCount>
        <missingDesc>the MadMan</missingDesc>
      </li>
      <li Class="RitualRoleColonist">
        <label>focus</label>
        <id>focus</id>
        <required>True</required>
        <maxCount>4</maxCount>
        <missingDesc>the focus of the insulting</missingDesc>
      </li>
      <li Class="RitualRolePrisoner">
        <label>target</label>
        <missingDesc>a prisoner</missingDesc>
        <id>target</id>
        <maxCount>1</maxCount>
        <required>True</required>
        <countsAsParticipant>False</countsAsParticipant>
        <ignoreBleeding>true</ignoreBleeding>
      </li>
    </roles>
    <stages Inherit="False">
      <li Class="RitualStage_InteractWithPrisoner">
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_PawnDeliveredOrNotValid" />
        </endTriggers>
        <failTriggers>
          <li Class="StageFailTrigger_TargetPawnUnreachable">
            <takerId>focus</takerId>
            <takeeId>target</takeeId>
            <desc>Prisoner is not reachable.</desc>
          </li>
          <li Class="StageFailTrigger_PawnAsleep">
            <desc>escort asleep</desc>
            <pawnId>focus</pawnId>
          </li>
        </failTriggers>
        <roleBehaviors>
          <li>
            <roleId>madman</roleId>
            <dutyDef>DeliverPawnToAltar</dutyDef>
          </li>
          <li>
            <roleId>target</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <essential>True</essential>
        <endTriggers>
          <li Class="StageEndTrigger_RolesArrived">
            <roleIds>
              <li>focus</li>
              <li>target</li>
              <li>madman</li>
            </roleIds>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>focus</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_Lectern">
                <maxDistanceToFocus>1</maxDistanceToFocus>
              </li>
              <li Class="RitualPosition_OnInteractionCell" />
            </customPositions>
          </li>
          <li>
            <roleId>target</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_OnInteractionCell">
                <offset>(0,0,0)</offset>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>madman</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_Lectern">
                <maxDistanceToFocus>5</maxDistanceToFocus>
              </li>
              <li Class="RitualPosition_OnInteractionCell" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.7</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>focus</roleId>
            <dutyDef>SpeakOnCellFacingSpectators</dutyDef>
            <speakerInteraction>Speech_Awakening_UInsult</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_Lectern">
                <maxDistanceToFocus>1</maxDistanceToFocus>
              </li>
              <li Class="RitualPosition_OnInteractionCell"></li>
            </customPositions>
          </li>
          <li>
            <roleId>target</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
          <li>
            <roleId>madman</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
        </roleBehaviors>
      </li>
      <li Class="RitualStage_InteractWithRole">
        <targetId>target</targetId>
        <defaultDuty>Spectate</defaultDuty>
        <essential>True</essential>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.3</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>focus</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
          <li>
            <roleId>target</roleId>
            <dutyDef>LayDownAwake</dutyDef>
          </li>
          <li>
            <roleId>madman</roleId>
            <dutyDef>Idle</dutyDef>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>
  <RitualBehaviorDef Name="InsultBehaviorBase" Abstract="True" ParentName="DateRitualBehavior">
    <preceptRequirements>
      <li Class="PreceptRequirement_Altar" />
    </preceptRequirements>
    <durationTicks>6000</durationTicks>
    <roles Inherit="False">
      <li Class="RitualRoleTag">
        <label>MadMan</label>
        <id>madman</id>
        <tag>Leader</tag>
        <precept>IdeoRole_Leader</precept>
        <required>True</required>
        <substitutable>true</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>False</countsAsParticipant>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
      </li>
    </roles>
  </RitualBehaviorDef>
</Defs>